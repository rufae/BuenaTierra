{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "ExpiresInMinutes": 30,
    "RefreshExpiresInDays": 30,
    "Issuer": "BuenaTierraAPI",
    "Audience": "BuenaTierraClients"
  },
  "BuenaTierrAI": {
    "Enabled": true,
    "ProviderBaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "ApiKeyFilePath": "config/buenatierr-ai.key",
    "Temperature": 0.2,
    "MaxOutputTokens": 1500,
    "MaxHistoryMessages": 8,
    "MaxToolPayloadChars": 30000
  }
}
